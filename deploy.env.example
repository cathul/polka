# Copy to .env. Use an existing absolute directory containing your library.
POLKA_BOOKS_PATH=/absolute/path/to/books
# Use 0.0.0.0 to allow connections from other devices on your LAN.
POLKA_BIND_IP=127.0.0.1
POLKA_BIND_PORT=12791
# Configure SMTP and personal recipient addresses in Polka, not in this file.
